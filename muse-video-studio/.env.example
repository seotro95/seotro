# Default desktop: sign in on the Muse page embedded inside the tool.
# No Chrome/Edge installation is required by npm start / start.bat.
MUSE_TRANSPORT=browser
PORT=8788
# Optional absolute directory for the desktop app's own saved session.
# MUSE_DESKTOP_DATA=
# Optional CSS selector for an explicitly labelled token/credit balance outside chat.
# MUSE_BALANCE_SELECTOR=

# Advanced only: an independently implemented, compatible API adapter.
# Set MUSE_TRANSPORT=adapter to use it. Do not use the Muse homepage as its URL.
MUSE_ADAPTER_URL=
MUSE_ADAPTER_TOKEN=

# Legacy external-browser login only: npm run start:web / npm run dev.
# MUSE_BROWSER_CHANNEL=msedge
# MUSE_PROFILE_ROOT=
# MUSE_ACCOUNT_PROFILE=
