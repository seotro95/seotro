# Default: sign in directly in a dedicated local Chrome/Edge window.
MUSE_TRANSPORT=browser
# Optional: chrome or msedge. Leave unset to try Chrome, then Edge.
# MUSE_BROWSER_CHANNEL=msedge
# Optional: root directory for the one private browser profile.
# MUSE_PROFILE_ROOT=
# Advanced only: a separately implemented, compatible API adapter.
# Set MUSE_TRANSPORT=adapter to use it. Do not set the Muse homepage as its URL.
MUSE_ADAPTER_URL=
MUSE_ADAPTER_TOKEN=
PORT=8788

# Optional CSS selector for an explicitly labelled token/credit balance in Muse.
# MUSE_BALANCE_SELECTOR=

# Optional absolute path to reuse one existing profile (no profiles are deleted).
# MUSE_ACCOUNT_PROFILE=
