{
  "name": "muse-video-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env server.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --env-file-if-exists=.env server.mjs",
    "test": "node tests/core.test.ts && node tests/server.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
