{
  "name": "muse-video-studio",
  "version": "1.4.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy server.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node desktop-launcher.mjs",
    "test": "node tests/core.test.ts && node tests/server.test.mjs && node tests/browser-launch.test.mjs && node tests/balance.test.mjs",
    "test:e2e": "playwright test",
    "test:browser-bridge": "node tests/muse-browser.test.mjs",
    "start:web": "node --use-env-proxy server.mjs",
    "test:desktop": "node tests/desktop.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "electron": "45.2.2",
    "lucide-react": "1.67.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
